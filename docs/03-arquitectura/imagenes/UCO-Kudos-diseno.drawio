<mxfile host="drawio" agent="UCO Kudos" version="24.0.0"><diagram name="Paquetes del back" id="pq"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2080" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pq-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;[Paquetes] API de UCO Kudos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Cómo se organiza el código del back. Cada módulo es un hexágono, y un módulo solo usa de otro su &lt;b&gt;aplicacion.puerto.entrada&lt;/b&gt;. ReglasDeArquitecturaTest (ArchUnit) lo comprueba en cada build.&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/></mxCell><mxCell id="pq-2" value="&lt;b&gt;co.edu.uco.ucokudos&lt;/b&gt;" style="shape=folder;tabWidth=220;tabHeight=26;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=28;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1540" height="1250" as="geometry"/></mxCell><mxCell id="pq-3" value="&lt;b&gt;UcoKudosApplication&lt;/b&gt;&lt;br&gt;arranque de Spring Boot" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="240" height="60" as="geometry"/></mxCell><mxCell id="pq-4" value="&lt;b&gt;ConfiguracionComun&lt;/b&gt;&lt;br&gt;el reloj (Clock) que comparten" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="260" height="60" as="geometry"/></mxCell><mxCell id="pq-5" value="&lt;b&gt;«módulo» 