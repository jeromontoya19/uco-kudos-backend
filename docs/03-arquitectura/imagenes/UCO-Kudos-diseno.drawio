row=open;endSize=12;dashed=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pq-15" target="pq-34"><mxGeometry relative="1" x="0.5077" as="geometry"><Array as="points"><mxPoint x="1560" y="480"/><mxPoint x="1560" y="1037.5"/></Array></mxGeometry></mxCell><mxCell id="pq-47" value='&lt;b style="font-size:13px"&gt;Reglas que comprueba ReglasDeArquitecturaTest&lt;/b&gt;&lt;ol style="margin:8px 0 0 0;padding-left:18px"&gt;&lt;li&gt;El dominio no depende de frameworks (Spring, JPA, Servlet, Jackson).&lt;/li&gt;&lt;li&gt;El dominio no depende de aplicacion ni de infraestructura.&lt;/li&gt;&lt;li&gt;La aplicacion no depende de la infraestructura.&lt;/li&gt;&lt;li&gt;Los módulos no tienen ciclos entre sí.&lt;/li&gt;&lt;li&gt;Un módulo solo usa el aplicacion.puerto.entrada de otro.&lt;/li&gt;&lt;/ol&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1620" y="240" width="420" height="190" as="geometry"/></mxCell><mxCell id="pq-48" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Leyenda&lt;/b&gt;&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1620" y="470" width="420" height="30" as="geometry"/></mxCell><mxCell id="pq-49" value="&lt;b&gt;puerto.entrada&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1620" y="510" width="200" height="40" as="geometry"/></mxCell><mxCell id="pq-50" value="Lo único que ven los otros módulos" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;v