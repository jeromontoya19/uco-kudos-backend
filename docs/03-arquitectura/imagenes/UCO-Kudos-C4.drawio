eometry"/></mxCell><mxCell id="dp-35" value="Sistema externo" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1275" width="220" height="40" as="geometry"/></mxCell><mxCell id="dp-36" value="" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1335" width="10" height="10" as="geometry"/></mxCell><mxCell id="dp-37" value="" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="110" y="1335" width="10" height="10" as="geometry"/></mxCell><mxCell id="dp-38" value="" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=10;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-36" target="dp-37"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="dp-39" value='&lt;font style="font-size:11px"&gt;Llamada (sale de quien la hace)&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="1325" width="250" height="30" as="geometry"/></mxCell><mxCell id="dp-40" value="" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="10" height="10" as="geometry"/></mxCell><mxCell id="dp-41" value="" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="110" y="1375" width="10" height="10" as="geometry"/></mxCell><mxCell id="dp-42" value="" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=10;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="dp-40" target="dp-41"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="dp-43" value='&lt;font style="font-size:11px"&gt;Planeada, aún sin uso&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="1365" width="250" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4 · Nivel 3 — Componentes de la API: publicar y consultar" id="n3a"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3a-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;[Nivel 3 · Componentes] API de UCO Kudos: publicar y consultar&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Por dónde pasa una petición de la PWA, desde la seguridad hasta la base. El envío de los avisos está en la vista siguiente.&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/></mxCell><mxCell id="n3a-2" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Aplicación web móvil (PWA)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: React, Vite y TypeScript]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3a-3" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Auth0&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: proveedor de identidad]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Emite los tokens OIDC&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="280" height="140" as="geometry"/></mxCell><mxCell id="n3a-4" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;API de UCO Kudos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Contenedor: Java 21 y Spring Boot]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="1880" height="1230" as="geometry"/></mxCell><mxCell id="n3a-5" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Seguridad&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: identidad · Spring Security]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ConfiguracionDeSeguridad y ConvertidorDeTokenAPersona: valida el token y pone en la sesión a la persona y su rol&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="300" height="160" as="geometry"/></mxCell><mxCell id="n3a-6" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Controlador de personas&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: identidad · REST]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ControladorDePersonas: GET /api/personas y /api/yo&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="670" width="280" height="140" as="geometry"/></mxCell><mxCell id="n3a-7" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Controlador de Kudos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: kudos · REST]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ControladorDeKudos: POST y GET /api/kudos, GET /api/categorias&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="1360" y="670" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3a-8" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Consulta de personas&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: identidad · caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ConsultaDePersonas: identifica, lista y da nombres y contactos&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="950" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3a-9" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Publicación de Kudos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: kudos · caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;PublicarKudoEnTransaccion y PublicacionDeKudos: todo en una transacción&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackground