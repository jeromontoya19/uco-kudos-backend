1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2480" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dp-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;[Despliegue · Producción] UCO Kudos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Dónde corre cada contenedor al 15-nov-2026 (SPK-04, ADR-022). La API, la base y los adjuntos están juntos en canadacentral; Static Web Apps solo se administra desde westus2.&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="80" as="geometry"/></mxCell><mxCell id="dp-2" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Celular o computador del usuario&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Nodo de despliegue: navegador moderno; la PWA se instala en el celular]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=top;container=0;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="460" height="250" as="geometry"/></mxCell><mxCell id="dp-3" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Aplicación web móvil (PWA)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: React, Vite y TypeScript]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Se instala en el celular; el service worker la actualiza sola&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="380" height="150" as="geometry"/></mxCell><mxCell id="dp-4" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Auth0&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: proveedor de identidad]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Cuentas, inicio de sesión y tokens OIDC (ADR-018)&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="300" height="150" as="geometry"/></mxCell><mxCell id="dp-5" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;UptimeRobot&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: monitor]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Revisa la salud desde fuera de Azure; página pública de estado&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="2120" y="130" width="300" height="150" as="geometry"/></mxCell><mxCell id="dp-6" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Brevo&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: correo]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Entrega el aviso por correo (ADR-019)&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="2120" y="645" width="300" height="150" as="geometry"/></mxCell><mxCell id="dp-7" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;WhatsApp Cloud API de Meta&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: WhatsApp]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Entrega el aviso con la plantilla kudo_recibido (ADR-020)&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="2120" y="815" width="300" height="150" as="geometry"/></mxCell><mxCell id="dp-8" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Microsoft Azure&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Nodo de despliegue: suscripción Azure for Students · grupo de recursos rg-uco-kudos]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;fillColor=#F7FAFD;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="1540" height="1140" as="geometry"/></mxCell><mxCell id="dp-9" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Azure Static Web Apps · ucokudos-web&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Plan Free · se administra en westus2 y se sirve desde la red global]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="400" height="260" as="geometry"/></mxCell><mxCell id="dp-10" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Archivos de la PWA&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenido estático]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;HTML, JavaScript, manifiesto y service worker&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="320" height="150" as="geometry"/></mxCell><mxCell id="dp-11" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Región canadacentral&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Nodo de despliegue]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="920" y="500" width="1020" height="1000" as="geometry"/></mxCell><mxCell id="dp-12" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Azure Container Apps · ucokudos-api&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Entorno Express env-uco-kudos · 0,5 vCPU y 1 GiB&lt;br&gt;una réplica siempre encendida]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=right;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="940" height="320" as="geometry"/></mxCell><mxCell id="dp-13" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;API de UCO Kudos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: Java 21 y Spring Boot, imagen de GHCR]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Cinco módulos hexagonales, despachador de avisos y canal en vivo en un solo proceso&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="680" width="320" height="160" as="geometry"/></mxCell><mxCell id="dp-14" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Servidor flexible ucokudos-db-4632&lt;br&gt;B1ms · PostgreSQL 16]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="960" y="1100" width="300" height="320" as="geometry"/></mxCell><mxCell id="dp-15" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Base de datos ucokudos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: PostgreSQL]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Un esquema por módulo; solo acepta TLS&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="990" y="1140" width="240" height="160" as="geometry"/></mxCell><mxCell id="dp-16" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Azure Storage&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Cuenta de almacenamiento ucokudos4632]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="1300" y="1100" width="300" height="320" as="geometry"/></mxCell><mxCell id="dp-17" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Almacén de adjuntos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: Azure Blob Storage]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#E6E6E6"&gt;Contenedor privado adjuntos; creado y vacío&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="1140" width="240" height="160" as="geometry"/></mxCell><mxCell id="dp-18" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Azure Monitor&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Observabilidad (ADR-024)]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;absoluteArcSize=0;fillColor=none;strokeColor=#666666;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=left;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="1640" y="1100" width="260" height="320" as="geometry"/></mxCell><mxCell id="dp-19" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Application Insights&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Trazas, métricas y registros]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="1660" y="1140" width="220" height="100" as="geometry"/></mxCell><mxCell id="dp-20" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;Log Analytics&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Registros del entorno y telemetría]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="1660" y="1255" width="220" height="95" as="geometry"/></mxCell><mxCell id="dp-21" value="&lt;b&gt;Descarga la aplicación&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.171875;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-3" target="dp-10"><mxGeometry relative="1" x="-0.3000" as="geometry"></mxGeometry></mxCell><mxCell id="dp-22" value="&lt;b&gt;Inicia sesión&lt;/b&gt;&lt;br&gt;[OIDC, código con PKCE]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-3" target="dp-4"><mxGeometry relative="1" x="0.3987" as="geometry"><Array as="points"><mxPoint x="190" y="255"/></Array></mxGeometry></mxCell><mxCell id="dp-23" value="&lt;b&gt;Llama a la API con el token&lt;br&gt;y recibe el push en vivo&lt;/b&gt;&lt;br&gt;[REST y SSE sobre HTTPS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1875;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-3" target="dp-13"><mxGeometry relative="1" x="0.6480" as="geometry"><Array as="points"><mxPoint x="1060" y="255"/></Array></mxGeometry></mxCell><mxCell id="dp-24" value="&lt;b&gt;Consulta /actuator/health&lt;br&gt;cada 5 min&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8125;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-5" target="dp-13"><mxGeometry relative="1" x="-0.7589" as="geometry"><Array as="points"><mxPoint x="2270" y="600"/><mxPoint x="1260" y="600"/></Array></mxGeometry></mxCell><mxCell id="dp-25" value="&lt;b&gt;Descarga las llaves públicas&lt;br&gt;para validar los tokens&lt;/b&gt;&lt;br&gt;[JWKS sobre HTTPS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0;exitY=0.78125;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp-13" target="dp-4"><mxGeometry relative="1" x="-0.0303" as="geometry"></mxGeometry></mxCell><mxCell id="dp-26" value="&lt;b&gt;Envía el correo&lt;/b&gt;&lt;br&gt;[API HT