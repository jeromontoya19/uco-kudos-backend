=arc;jumpSize=12;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3a-40" target="n3a-41"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="n3a-43" value='&lt;font style="font-size:11px"&gt;Llamada (sale de quien la hace)&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="920" width="220" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4 · Nivel 3 — Componentes de la API: avisos" id="n3b"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2240" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3b-1" value='&lt;font style="font-size:20px"&gt;&lt;b&gt;[Nivel 3 · Componentes] API de UCO Kudos: avisos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Cómo salen el correo, el WhatsApp y el push de un Kudo (ADR-003). Los avisos se envían apenas se confirma la publicación; la vuelta de cada 5 s hace los reintentos.&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="70" as="geometry"/></mxCell><mxCell id="n3b-2" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Publicación de Kudos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: kudos · caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#3A5A78"&gt;Publica el Kudo en una transacción&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#D6EEFB;fontColor=#083F75;align=center;arcSize=6;strokeColor=#2086C9;dashed=1;dashPattern=6 4;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-3" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Aplicación web móvil (PWA)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: React, Vite y TypeScript]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-4" value='&lt;font style="font-size:13px"&gt;&lt;b&gt;API de UCO Kudos · módulo avisos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;[Contenedor: Java 21 y Spring Boot]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=11;spacingLeft=12;spacingRight=12;spacingBottom=8;spacingTop=8;align=right;verticalAlign=bottom;container=0;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="1320" height="880" as="geometry"/></mxCell><mxCell id="n3b-5" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Programación de avisos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: caso de uso con decorador]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ProgramarAvisosConDespachoInmediato y ProgramacionDeAvisos: un aviso pendiente por canal&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-6" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Despachador&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: tarea en segundo plano]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;DespachadorProgramado: atiende el anuncio en otro hilo y corre cada 5 s; una tanda a la vez&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-7" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Canal en vivo&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: REST con SSE]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;ControladorEnVivo y ConexionesEnVivo: GET /api/avisos/en-vivo, latido cada 25 s&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="400" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-8" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Despacho de avisos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;DespacharAvisosEnTransaccion y DespachoDeAvisos: reintenta a los 1, 2, 4, 8 y 15 min&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-9" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Canales de aviso&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: una estrategia por canal]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;CorreoPorBrevo, WhatsAppPorMeta y PushEnVivo (CanalDeAviso)&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="680" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-10" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Repositorio de avisos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: Spring Data JDBC]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#F2F2F2"&gt;RepositorioDeAvisosJdbc: la tabla avisos.aviso es el outbox&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-11" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Registro de auditoría&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: auditoria · caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#3A5A78"&gt;Guarda AVISO_CORREO, AVISO_WHATSAPP y AVISO_PUSH&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#D6EEFB;fontColor=#083F75;align=center;arcSize=6;strokeColor=#2086C9;dashed=1;dashPattern=6 4;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-12" value='&lt;font style="font-size:14px"&gt;&lt;b&gt;Consulta de personas&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente: identidad · caso de uso]&lt;/div&gt;&lt;div style="margin-top:6px"&gt;&lt;font style="font-size:11px" color="#3A5A78"&gt;Da el correo y el celular del destinatario&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#D6EEFB;fontColor=#083F75;align=center;arcSize=6;strokeColor=#2086C9;dashed=1;dashPattern=6 4;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="960" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-13" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Brevo&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: correo]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="647.5" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-14" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;WhatsApp Cloud API de Meta&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistema externo: WhatsApp]&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="830" width="300" height="140" as="geometry"/></mxCell><mxCell id="n3b-15" value='&lt;font style="font-size:15px"&gt;&lt;b&gt;Base de datos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Contenedor: PostgreSQL]&lt;/div&gt;' style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="1280" width="300" height="150" as="geometry"/></mxCell><mxCell id="n3b-16" value="&lt;b&gt;Programa los avisos en&lt;br&gt;su misma transacción&lt;/b&gt;&lt;br&gt;[ProgramarAvisos]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-2" target="n3b-5"><mxGeometry relative="1" x="-0.5000" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-17" value="&lt;b&gt;Anuncia AvisosProgramados&lt;/b&gt;&lt;br&gt;al confirmarse&lt;br&gt;[evento de Spring]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-5" target="n3b-6"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-18" value="&lt;b&gt;Abre el canal con el token&lt;br&gt;y recibe kudo-recibido&lt;/b&gt;&lt;br&gt;[SSE sobre HTTPS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-3" target="n3b-7"><mxGeometry relative="1" x="-0.5000" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-19" value="&lt;b&gt;Despacha los avisos listos&lt;/b&gt;&lt;br&gt;[DespacharAvisos]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-6" target="n3b-8"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-20" value="&lt;b&gt;Envía cada aviso&lt;/b&gt;&lt;br&gt;[CanalDeAviso]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-8" target="n3b-9"><mxGeometry relative="1" x="0.0000" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-21" value="&lt;b&gt;Audita cada intento&lt;/b&gt;&lt;br&gt;[RegistrarEnAuditoria]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-8" target="n3b-11"><mxGeometry relative="1" x="-0.0769" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-22" value="&lt;b&gt;Lee los listos y&lt;br&gt;guarda el resultado&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-8" target="n3b-10"><mxGeometry relative="1" x="-0.4419" as="geometry"><Array as="points"><mxPoint x="660" y="770"/></Array></mxGeometry></mxCell><mxCell id="n3b-23" value="&lt;b&gt;Guarda un aviso&lt;br&gt;pendiente por canal&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-5" target="n3b-10"><mxGeometry relative="1" x="-0.5610" as="geometry"></mxGeometry></mxCell><mxCell id="n3b-24" value="&lt;b&gt;Correo y celular&lt;/b&gt;&lt;br&gt;[ConsultarContactos]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=12;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3b-8" target="n3b-12"><mxGeometry relative="1" x="0.0000" as="geometry"><Array as="points"><mxPoint x="1290" y="800"/><mxPoint x="1290" y="1030"/></Array></mxGeometry></mxCell><mxCell id="n3b-25" value="&lt;b&gt;Push a las&lt;br&gt;conexiones abiertas&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=11;fon